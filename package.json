{
  "name": "prisma-extension-autozod",
  "version": "1.0.4",
  "description": "Contract-aware compile-time linting and runtime Zod validation for Prisma ORM 8 (@prisma/orm-postgres)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "prisma",
    "prisma8",
    "orm-postgres",
    "zod",
    "validation",
    "middleware",
    "autozod",
    "orm",
    "contract-linting",
    "prisma-orm-extension",
    "prisma-zod-generator"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammed Thamer",
    "email": "mt20021911@gmail.com",
    "url": "https://github.com/abzr0o"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abzr0o/prisma-extension-autozod.git"
  },
  "bugs": {
    "url": "https://github.com/abzr0o/prisma-extension-autozod/issues"
  },
  "homepage": "https://github.com/abzr0o/prisma-extension-autozod#readme",
  "peerDependencies": {
    "@prisma/orm-postgres": ">=8.0.0-rc.0 <9.0.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.22",
    "tsup": "^9.0.0",
    "typescript": "5.8.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@prisma/orm-family-sql": "8.0.0-rc.22"
  }
}
